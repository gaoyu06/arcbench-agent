# OpenAI-compatible endpoint of the model
OPENAI_BASE_URL=https://api.example.com/v1
OPENAI_API_KEY=
# Model of every session (default: deepseek-v4-flash-vision-exp)
MODEL=deepseek-v4-flash-vision-exp

# Only needed when MODEL cannot read images
# VISUAL_MODEL=deepseek-v4-flash-vision-exp
# VISUAL_BASE_URL=
# VISUAL_API_KEY=

# Optional limits
# AGENT_TIME_LIMIT_MINUTES=0   # wall-clock limit of the build; 0 means none
# AGENT_HELPERS=4              # subagents running at once
# AGENT_SANDBOX=1              # 0 runs commands without the filesystem sandbox
